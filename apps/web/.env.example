# Copy to .env.local and fill in. NEVER commit the filled file.
# .env.local is gitignored; this template is the only env file in the repo.

# --- Supabase ---
# NEXT_PUBLIC_* keys are exposed to the browser by design. The anon key is
# safe there because RLS protects every table. The service role key is NOT:
# it bypasses RLS, so it must never gain a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
INTERNAL_WORKER_TOKEN=dev-internal-token
INTERNAL_WORKER_URL=http://127.0.0.1:8080

# --- Discord ---
# OAuth app credentials (server-side only). CLIENT_ID is also used by the authorize route.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:3000/api/discord/callback

# --- LLM ---
LLM_PROVIDER=openai
LLM_CHEAP_MODEL=gpt-4o-mini
LLM_MID_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# --- Social publishing ---
# X/Twitter credentials are NOT read from here. They live per tenant in the
# Supabase Vault and are entered from Settings > Integrations.
