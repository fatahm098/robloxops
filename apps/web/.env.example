# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
INTERNAL_WORKER_TOKEN=dev-internal-token

# --- Discord ---
# OAuth app credentials (server-side only). CLIENT_ID is also used by the authorize route.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:3000/api/discord/callback

# --- LLM ---
LLM_PROVIDER=openai
LLM_CHEAP_MODEL=gpt-4o-mini
LLM_MID_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
