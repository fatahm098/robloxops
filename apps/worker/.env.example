# --- Core ---
APP_ENV=development
LOG_LEVEL=INFO

# Postgres connection string (Supabase pooler or direct).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/robloxops

# Bearer token expected on every worker endpoint except /health.
INTERNAL_WORKER_TOKEN=dev-internal-token

# Stable identity for job claiming. Defaults to hostname-pid.
WORKER_ID=
WORKER_BATCH_SIZE=5

# --- LLM (any OpenAI-compatible endpoint) ---
# Leave LLM_API_KEY empty to run the deterministic FakeLLM (offline dev/tests).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_FAST=gpt-4o-mini
LLM_MODEL_MID=gpt-4o-mini
LLM_MODEL_VISION=gpt-4o
LLM_TIMEOUT_SECONDS=30

# --- Discord bot ---
DISCORD_BOT_TOKEN=
# Base URL the bot uses for the fast-path intake call.
DISCORD_WORKER_URL=http://127.0.0.1:8080
